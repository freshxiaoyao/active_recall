    await provider.ingestEpisode(episode({
      id: "historical",
      occurredAt: "2026-08-01T00:00:00.000Z",
      entities: [{ name: "user", type: "User" }, { name: "DeepSeek", type: "Model" }],
      relations: [{ from: "user", type: "prefers", to: "DeepSeek" }],
